# Copy to .env and fill in. .env is git-ignored.
# Every setting in backend/config.yaml can be overridden here using the FRS_
# prefix and __ for nesting. Env vars beat the YAML file; CLI flags beat both.

# --- Phase 1: detection / tracking ------------------------------------------
# FRS_DEVICE=cuda
# FRS_DETECTION__MODEL=yolov8n.pt
# FRS_DETECTION__CONF_THRESHOLD=0.35
# FRS_TRACKING__MAX_AGE=30

# --- Phase 7: database ------------------------------------------------------
# FRS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/faceless_frs
# Key for encrypting biometric templates at rest (build-plan section 8).
# REQUIRED: enrolment refuses to write without it. Keep it somewhere other than
# the database it protects -- without the key, enrolments cannot be read back.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FRS_TEMPLATE_ENCRYPTION_KEY=
#
# Local development with throwaway data only: write templates in the clear.
# Never set this anywhere real footage of a real person has been enrolled.
# FRS_ALLOW_PLAINTEXT_TEMPLATES=1

# --- Authentication ---------------------------------------------------------
# Signing key for session tokens. Without it a random one is generated per
# process, so everyone is logged out on every restart.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRS_AUTH_SECRET=

# --- Phase 9: alerting ------------------------------------------------------
# Alerts fire only on human-confirmed decisions, and sending needs --send too.
# FRS_ALERTS__TRANSPORT=smtp
# FRS_ALERTS__SMTP_HOST=smtp.example.com
# FRS_ALERTS__SMTP_USERNAME=
# FRS_ALERTS__SMTP_PASSWORD=
# FRS_ALERTS__SMTP_SENDER=frs@example.com
# FRS_ALERTS__SMTP_RECIPIENTS=duty@example.com,supervisor@example.com
#
# FRS_ALERTS__TWILIO_ACCOUNT_SID=
# FRS_ALERTS__TWILIO_AUTH_TOKEN=
# FRS_ALERTS__TWILIO_FROM_NUMBER=+15550001111
# FRS_ALERTS__TWILIO_TO_NUMBERS=+15552223333
