*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Testing / tooling ------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Model weights (re-downloadable; keep them out of git) ------------------
data/models/
*.pt
*.pth
*.onnx
*.engine

# --- Biometric data ---------------------------------------------------------
# Enrollment footage, embeddings and CCTV clips are personal data. They must
# never be committed -- see section 8 of the build plan.
#
# The database counts: it holds biometric templates and the full match audit
# trail. Encrypted at rest when a key is configured, but a committed database
# is still a committed watchlist.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/enrollment/*
!data/enrollment/.gitkeep
data/test_videos/*
!data/test_videos/.gitkeep
data/output/
*.mp4
*.avi
*.mov
*.mkv
*.npy
*.npz

# --- Frontend ---------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
